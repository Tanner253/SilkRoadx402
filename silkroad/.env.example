# OpenFund — environment variables
# Copy to .env.local for development. Never commit real values.

# --- Required ---------------------------------------------------------------

# MongoDB connection string.
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/openfund

# Cloudinary, for campaign cover uploads. Either the single URL…
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# …or the three parts:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Admin moderation (/admin). In production admin login is DISABLED unless
# both are set; JWT_SECRET must be at least 16 characters.
# Generate a secret with: openssl rand -base64 48
ADMIN_CODE=
JWT_SECRET=

# Salt for hashing reporter IPs (anonymous reports). Any long random string.
APP_SECRET=

# --- Optional ---------------------------------------------------------------

# Robinhood Chain RPC for live donation checks. Defaults to the public
# endpoint (https://rpc.mainnet.chain.robinhood.com), which is fine.
# ROBINHOOD_RPC_URL=

# An ARCHIVE-capable Robinhood Chain RPC. Only used when a donor's watch has
# lapsed for more than ~10 minutes (the public node's state window) AND their
# wallet has sent something since — i.e. rarely. Without it such watches wait
# as "needs_archive" instead of resolving.
# ROBINHOOD_ARCHIVE_RPC_URL=

# Shows the community banner in the navbar when set.
# NEXT_PUBLIC_X_COMMUNITY_URL=
